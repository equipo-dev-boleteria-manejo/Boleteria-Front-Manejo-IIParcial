# URL de tu proyecto en Supabase (Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública anónima o publishable key (Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key-aqui

# Llave de Stripe (opcional para pruebas de pago)
VITE_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# Solo para scripts locales de mantenimiento (npm run seed:test)
# NO uses el prefijo VITE_ ni expongas estas variables en el navegador.
# Settings > API > Project URL / service_role key.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=